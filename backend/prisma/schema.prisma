generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  permissions Json     @default("[]")
  users       User[]

  @@map("roles")
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  fullName      String         @map("full_name") @db.VarChar(100)
  phone         String?        @unique @db.VarChar(20)
  roleId        String         @map("role_id") @db.Uuid
  avatarUrl     String?        @map("avatar_url") @db.Text
  isActive      Boolean        @default(true) @map("is_active")
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz

  role          Role           @relation(fields: [roleId], references: [id])
  workShifts    WorkShift[]
  orders        Order[]
  inventoryLogs InventoryLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Zone {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  tables      Table[]

  @@map("zones")
}

model Table {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableNumber String        @unique @map("table_number") @db.VarChar(20)
  zoneId      String        @map("zone_id") @db.Uuid
  capacity    Int           @db.Integer
  status      String        @default("available") @db.VarChar(20)
  qrCodeUrl   String?       @map("qr_code_url") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  
  // Hỗ trợ "Chuyển bàn & Gộp bàn"
  mergedToId  String?       @map("merged_to_id") @db.Uuid
  mergedTo    Table?        @relation("TableMerges", fields: [mergedToId], references: [id])
  mergedFrom  Table[]       @relation("TableMerges")

  zone        Zone          @relation(fields: [zoneId], references: [id])
  orders      Order[]
  reservations Reservation[]

  @@map("tables")
}

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @db.VarChar(100)
  icon      String?    @db.VarChar(50)
  sortOrder Int        @default(0) @map("sort_order") @db.Integer
  isActive  Boolean    @default(true) @map("is_active")
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId      String      @map("category_id") @db.Uuid
  name            String      @db.VarChar(200)
  description     String?     @db.Text
  price           Decimal     @db.Decimal(12,2)
  costPrice       Decimal?    @map("cost_price") @db.Decimal(12,2)
  imageUrl        String?     @map("image_url") @db.Text
  isAvailable     Boolean     @default(true) @map("is_available")
  isFeatured      Boolean     @default(false) @map("is_featured")
  prepTimeMinutes Int         @default(15) @map("prep_time_minutes") @db.Integer
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz

  category        Category    @relation(fields: [categoryId], references: [id])
  recipes         Recipe[]
  orderItems      OrderItem[]

  @@map("menu_items")
}

model Ingredient {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @db.VarChar(150)
  unit          String         @db.VarChar(30)
  stockQuantity Decimal        @default(0) @map("stock_quantity") @db.Decimal(10,3)
  minQuantity   Decimal        @default(0) @map("min_quantity") @db.Decimal(10,3)
  costPerUnit   Decimal        @map("cost_per_unit") @db.Decimal(12,2)
  supplier      String?        @db.VarChar(200)
  isActive      Boolean        @default(true) @map("is_active")
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  recipes       Recipe[]
  inventoryLogs InventoryLog[]

  @@map("ingredients")
}

model Recipe {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId   String     @map("menu_item_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal    @db.Decimal(10,3)
  unit         String     @db.VarChar(30)
  note         String?    @db.Text

  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
  @@map("recipes")
}

model WorkShift {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  shiftDate   DateTime  @map("shift_date") @db.Date
  startTime   DateTime  @map("start_time") @db.Timestamptz
  endTime     DateTime? @map("end_time") @db.Timestamptz
  openingCash Decimal   @default(0) @map("opening_cash") @db.Decimal(12,2)
  closingCash Decimal?  @map("closing_cash") @db.Decimal(12,2)
  status      String    @default("open") @db.VarChar(20)
  notes       String?   @db.Text

  user        User      @relation(fields: [userId], references: [id])
  orders      Order[]

  @@map("work_shifts")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode      String      @unique @map("order_code") @db.VarChar(20)
  tableId        String?     @map("table_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  shiftId        String      @map("shift_id") @db.Uuid
  orderType      String      @default("dine_in") @map("order_type") @db.VarChar(20)
  status         String      @default("pending") @db.VarChar(30)
  subtotal       Decimal     @default(0) @db.Decimal(12,2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12,2)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(12,2)
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(12,2)
  pointsEarned   Int         @default(0) @map("points_earned") @db.Integer
  pointsUsed     Int         @default(0) @map("points_used") @db.Integer
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz
  customerId     String?     @map("customer_id") @db.Uuid

  table          Table?      @relation(fields: [tableId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  shift          WorkShift   @relation(fields: [shiftId], references: [id])
  customer       Customer?   @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  payment        Payment?

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  quantity   Int      @db.Integer
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12,2)
  subtotal   Decimal  @db.Decimal(12,2)
  status     String   @default("pending") @db.VarChar(20)
  notes      String?  @db.Text

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model Payment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  method         String    @db.VarChar(30)
  amount         Decimal   @db.Decimal(12,2)
  receivedAmount Decimal?  @map("received_amount") @db.Decimal(12,2)
  changeAmount   Decimal?  @map("change_amount") @db.Decimal(12,2)
  transactionId  String?   @map("transaction_id") @db.VarChar(100)
  status         String    @default("pending") @db.VarChar(20)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz
  metadata       Json?     @db.JsonB

  order          Order     @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Reservation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId        String    @map("table_id") @db.Uuid
  customerName   String    @map("customer_name") @db.VarChar(100)
  customerPhone  String    @map("customer_phone") @db.VarChar(20)
  partySize      Int       @map("party_size") @db.Integer
  reservedAt     DateTime  @map("reserved_at") @db.Timestamptz
  notes          String?   @db.Text
  status         String    @default("pending") @db.VarChar(20)
  telegramChatId String?   @map("telegram_chat_id") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  table          Table     @relation(fields: [tableId], references: [id])

  @@map("reservations")
}

model InventoryLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId   String    @map("ingredient_id") @db.Uuid
  changeQuantity Decimal   @map("change_quantity") @db.Decimal(10,3)
  reason         String    @db.VarChar(100)
  referenceId    String?   @map("reference_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  user           User       @relation(fields: [userId], references: [id])

  @@map("inventory_logs")
}

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String   @unique @db.VarChar(20)
  fullName    String   @map("full_name") @db.VarChar(100)
  points      Int      @default(0) @db.Integer
  totalSpent  Decimal  @default(0) @map("total_spent") @db.Decimal(12,2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  orders      Order[]

  @@map("customers")
}
